# Split mode: frontend Vite on :5173, backend Express on :5000
# Frontend dev server port (read by vite.config.ts; `npm run dev -- --port XXXX` overrides it)
FRONTEND_PORT=5173

# Backend URL for Vite proxy target (dev) and production API base
# In dev, Vite proxies /api -> backend, so keep VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://localhost:5000

# Environment Mode: development | production | test
NODE_ENV=development

# Frontend API Base URL (relative /api uses Vite proxy in dev)
VITE_API_BASE_URL=/api

# CORS Allowed Origin (backend reads this; must match frontend dev URL)
FRONTEND_URL=http://localhost:5173
